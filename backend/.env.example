# Copy to backend/.env and fill in. The server refuses to start if a required value is missing.

# --- Required ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/meditrack
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---
PORT=5050
NODE_ENV=development
# Production frontend origin, e.g. https://medi-track-lemon.vercel.app
FRONTEND_URL=
# Origins matching this regex are also allowed (Vercel preview deploys).
# To restrict previews to your own Vercel team: ^https://medi-track-[a-z0-9-]+-<team-slug>\.vercel\.app$
# CORS_PREVIEW_ORIGIN_REGEX=
